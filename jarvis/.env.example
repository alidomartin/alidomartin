# ─── Required ────────────────────────────────────────────────────────────────
# Your Jarvis Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_jarvis_telegram_bot_token_here

# Anthropic API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your Telegram user ID (use @userinfobot to find yours)
ALLOWED_USER_IDS=your_telegram_user_id_here

# ─── Optional ────────────────────────────────────────────────────────────────
# Your name — how Jarvis addresses you
OWNER_NAME=Martin

# N1 bot token (for cross-bot synchronization)
N1_BOT_TOKEN=

# Chat ID where Jarvis should forward alerts/briefings via N1 bot
N1_CHAT_ID=
