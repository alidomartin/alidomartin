# ── Required ──────────────────────────────────────────────────────────────
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Owner gate (recommended) ──────────────────────────────────────────────
# SHA-256 of a passphrase only you know. Without this set, no gate runs.
# Generate on macOS/Linux:
#   printf "your-secret-passphrase" | shasum -a 256
# Then paste the 64-char hex value below (lowercase).
# Note: this protects against casual local snooping, not a determined
# attacker with disk access. For real hardening use OS keychain.
OWNER_PASSPHRASE_SHA256=

# ── Optional ──────────────────────────────────────────────────────────────
MODEL=claude-sonnet-4-6
MAX_TOKENS=4096
MAX_TOOL_ITERATIONS=25
# VAULT_PATH=/absolute/path/to/jarvis

# ── Voice (Phase 1.5, not used yet) ───────────────────────────────────────
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# VOICE_PROVIDER=elevenlabs
# STT_PROVIDER=whisper
