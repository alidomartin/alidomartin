# ─── Weekly Social Magazine — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ── X (Twitter) API v2 ────────────────────────────────────────────────────────
# Create a project + app at https://developer.twitter.com/
# Generate a Bearer Token under "Keys and Tokens"
X_BEARER_TOKEN=your_x_bearer_token_here
X_USERNAME=alidomartin          # Your X handle (without @)

# ── Instagram Graph API ───────────────────────────────────────────────────────
# Requires an Instagram Business or Creator account linked to a Facebook Page.
# 1. Create a Meta app at https://developers.facebook.com/
# 2. Add "Instagram Graph API" product
# 3. Generate a long-lived access token (valid 60 days, needs refreshing)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here   # numeric ID, not username

# ── LinkedIn API ──────────────────────────────────────────────────────────────
# 1. Create an app at https://www.linkedin.com/developers/apps
# 2. Request "Share on LinkedIn" and "Sign In with LinkedIn" products
# 3. Generate an access token via OAuth 2.0
# 4. Your person URN is the ID portion of your LinkedIn profile URL
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_ID=your_linkedin_person_id_here  # numeric or alphanumeric

# ── WordPress ─────────────────────────────────────────────────────────────────
# Works with self-hosted WordPress (REST API) and WordPress.com.
# For self-hosted: create an Application Password in wp-admin > Users > Profile.
# The fetcher falls back to RSS if credentials are omitted.
WORDPRESS_SITE_URL=https://yourblog.com
WORDPRESS_USERNAME=your_wp_username
WORDPRESS_APP_PASSWORD=your_wp_app_password     # format: xxxx xxxx xxxx xxxx

# ── Substack ──────────────────────────────────────────────────────────────────
# No API key needed — Substack exposes a public RSS feed.
# Format: https://yourpublication.substack.com  (or the full /feed URL)
SUBSTACK_PUBLICATION_URL=https://yourpublication.substack.com

# ── Magazine settings ─────────────────────────────────────────────────────────
MAGAZINE_TITLE=Alido Martin — Weekly Digest
MAGAZINE_AUTHOR=Alido Martin
MAGAZINE_OUTPUT_DIR=magazine/output
LOOKBACK_DAYS=7
